{"info":{"description":"All endpoints require HTTP Basic auth. Demo users: admin/admin123 (ADMIN), staff/staff123 (STAFF), patient1/patient123 (PATIENT, linked to John Doe). All demo data is fictional.","name":"Healthcare Patient and Appointment Management System","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"name":"Who am I (staff)","request":{"auth":{"basic":{"password":"staff123","username":"staff"},"type":"basic"},"method":"GET","url":"{{baseUrl}}/api/auth/me"}},{"name":"Who am I (patient1)","request":{"auth":{"basic":{"password":"patient123","username":"patient1"},"type":"basic"},"method":"GET","url":"{{baseUrl}}/api/auth/me"}}],"name":"Auth"},{"item":[{"name":"Register patient (staff)","request":{"auth":{"basic":{"password":"staff123","username":"staff"},"type":"basic"},"body":{"mode":"raw","raw":"{\"firstName\":\"Mia\",\"lastName\":\"Chen\",\"dateOfBirth\":\"1993-07-21\",\"phone\":\"+1-555-0200\",\"email\":\"mia@example.com\",\"address\":\"1 Demo Way\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{baseUrl}}/api/patients"}},{"name":"Update patient (staff)","request":{"auth":{"basic":{"password":"staff123","username":"staff"},"type":"basic"},"body":{"mode":"raw","raw":"{\"firstName\":\"Mia\",\"lastName\":\"Chen\",\"dateOfBirth\":\"1993-07-21\",\"phone\":\"+1-555-0201\",\"email\":\"mia@example.com\",\"address\":\"2 Demo Way\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"PUT","url":"{{baseUrl}}/api/patients/3"}},{"name":"List patient summaries (staff)","request":{"auth":{"basic":{"password":"staff123","username":"staff"},"type":"basic"},"method":"GET","url":"{{baseUrl}}/api/patients"}},{"name":"Get patient detail (own record, patient1)","request":{"auth":{"basic":{"password":"patient123","username":"patient1"},"type":"basic"},"method":"GET","url":"{{baseUrl}}/api/patients/1"}}],"name":"Patients"},{"item":[{"name":"Add provider (staff)","re